<!-- No dc.creator / dc.contributor.author, but a dc.publisher is present: per the
     DataShare mapping the publisher (depositing institution) becomes the creator.
     dc.type "article" also exercises the spec mapping article -> Text. -->
<dim:dim xmlns:dim="http://www.dspace.org/xmlns/dspace/dim" dspaceType="ITEM">
  <dim:field mdschema="dc" element="publisher">University of Edinburgh</dim:field>
  <dim:field mdschema="dc" element="title">Dataset with no named creator</dim:field>
  <dim:field mdschema="dc" element="type">article</dim:field>
</dim:dim>
