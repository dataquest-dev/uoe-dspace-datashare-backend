<?xml version="1.0"?>
<!--
  - local-types.xml
  -
  - An empty registry for instance-specific, local metadata. Any non-standard
  - metadata fields should be added here to avoid polluting the standard
  - namespaces.
  - 
  -->
<dspace-dc-types>

  <dspace-header>
    <title>Registry of instance-specific metadata fields</title>
    <contributor.author>Ivan Mas&#xE1;r</contributor.author>
    <contributor.editor>$Author$</contributor.editor>
    <date.created>$Date$</date.created>
    <description>$Log$</description>
    <description.version>$Revision$</description.version>
  </dspace-header>

  <dc-schema>
    <name>local</name>
    <namespace>http://dspace.org/namespace/local/</namespace>
  </dc-schema>

  <dc-type>
    <schema>local</schema>
    <element>bitstream</element>
    <qualifier>redirectToURL</qualifier>
    <scope_note>Absolute path, on the DSpace server filesystem, of a file to be ingested as a
      bitstream of this item. Site administrators only. The value is cleared automatically once
      the file has been ingested, so that a later save cannot repeat the ingest. Despite the
      historical name, a URL is not a legal value.</scope_note>
  </dc-type>

